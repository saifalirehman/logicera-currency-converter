<?xml version="1.0"?>
<!-- Frontend route: the "currencyconverter" front name. -->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:App/etc/routes.xsd">
    <router id="standard">
        <route id="currencyconverter" frontName="currencyconverter">
            <module name="Logicera_CurrencyConverter"/>
        </route>
    </router>
</config>
