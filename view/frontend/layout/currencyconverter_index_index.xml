<?xml version="1.0"?>
<!-- Layout for the converter page: sets the title and renders the converter block. -->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <title>Currency Converter</title>
    </head>
    <body>
        <referenceBlock name="page.main.title">
            <action method="setPageTitle">
                <argument name="title" xsi:type="string" translate="true">Currency Converter</argument>
            </action>
        </referenceBlock>
        <referenceContainer name="content">
            <block name="logicera.currency.converter"
                   class="Magento\Framework\View\Element\Template"
                   template="Logicera_CurrencyConverter::converter.phtml">
                <arguments>
                    <argument name="view_model" xsi:type="object">Logicera\CurrencyConverter\ViewModel\Converter</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
